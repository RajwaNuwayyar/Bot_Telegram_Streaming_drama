# ================================================================
# DRAMABOT CONFIGURATION (.env)
# ================================================================

# Token bot dari Telegram @BotFather
# Contoh: 7123456789:AAFlM_ExampleTokenStringHere
BOT_TOKEN=ISI_DENGAN_TOKEN_BOTFATHER_ANDA

# Username bot (tanpa tanda @)
BOT_USERNAME=dailydramabot

# ID Channel Privat tempat penyimpanan video drama (CDN Storage)
# Catatan: ID channel supergroup di Telegram biasanya diawali dengan -100
# Contoh: -1001987654321
PRIVATE_CHANNEL_ID=-1001234567890

# URL Telegram Mini App DramaBot
WEB_APP_URL=https://t.me/dailydramabot/app

# Link Channel / Grup Resmi Telegram
OFFICIAL_GROUP_URL=https://t.me/dailydrama_official

# Telegram User ID Anda (Admin) untuk menerima notifikasi upload video baru
# Dapatkan ID Anda via bot @userinfobot
ADMIN_USER_ID=0

# Port HTTP Server (Webhook pembayaran & integrasi Mini App)
SERVER_PORT=8080

# Lokasi File Database SQLite (otomatis dibuat dan dimigrasi)
DATABASE_PATH=dramabot.db

# URL Webhook Pembayaran QRIS (diserahkan ke Payment Coordinator)
PAYMENT_WEBHOOK_URL=http://localhost:8080/api/payment/webhook

# Konfigurasi Midtrans Server Key
MIDTRANS_SERVER_KEY=Mid-server-YOUR_SERVER_KEY_HERE
